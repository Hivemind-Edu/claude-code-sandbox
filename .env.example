## Required
GITHUB_TOKEN=<YOUR-GITHUB-TOKEN>

## Slack Integration (optional - falls back to console output)
SLACK_BOT_TOKEN=<YOUR-SLACK-BOT-TOKEN>

## MCP Server Configuration (optional - enables additional capabilities)

# Sentry - for production error investigation
# Get from: Sentry → Settings → User Auth Tokens
# Required scopes: org:read, project:read, project:write, team:read, event:write
SENTRY_AUTH_TOKEN=sntrys_<YOUR-SENTRY-AUTH-TOKEN>

# PostHog - for analytics and feature flags
# Get from: PostHog → Settings → Personal API Keys (use "MCP Server" preset)
# IMPORTANT: Must include "Bearer " prefix
POSTHOG_AUTH_HEADER=Bearer phx_<YOUR-POSTHOG-API-KEY>

# Expo - for Expo/React Native documentation and EAS
# Get from: expo.dev → Settings → Access Tokens
EXPO_TOKEN=<YOUR-EXPO-ACCESS-TOKEN>

# Langfuse - for LLM tracing and debugging
# Get from: Langfuse → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-<YOUR-PUBLIC-KEY>
LANGFUSE_SECRET_KEY=sk-lf-<YOUR-SECRET-KEY>
